rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isAdminEmail() {
      return isVerified() && request.auth.token.email == 'fatmasoltan1972@gmail.com';
    }

    function isAdmin() {
      return isAdminEmail() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidStudent(data, studentUid) {
      return data.keys().hasAll([
        'uid',
        'studentName',
        'stage',
        'specializationType',
        'specialization',
        'unlockedCourseIds',
        'completedLessonIds',
        'quizAnswers',
        'notesByLesson',
        'supervisorNotes',
        'attendanceRate',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'studentName',
        'stage',
        'specializationType',
        'specialization',
        'unlockedCourseIds',
        'completedLessonIds',
        'quizAnswers',
        'examResults',
        'notesByLesson',
        'supervisorNotes',
        'attendanceRate',
        'attendanceDates',
        'walletBalance',
        'approvalStatus',
        'isBlocked',
        'autoBlockExempt',
        'blockReason',
        'activeDeviceIds',
        'deviceDetails',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == studentUid
      && data.studentName is string
      && data.studentName.size() >= 2
      && data.studentName.size() <= 120
      && data.stage in [
        'الصف الأول الثانوي',
        'الصف الثاني الثانوي',
        'الصف الثالث الثانوي',
        'البكالوريا'
      ]
      && data.specializationType in ['شعبة', 'مسار']
      && data.specialization is string
      && data.specialization.size() >= 2
      && data.specialization.size() <= 120
      && data.unlockedCourseIds is list
      && data.unlockedCourseIds.size() <= 20
      && (data.unlockedCourseIds.size() == 0 || data.unlockedCourseIds[0] is string)
      && data.completedLessonIds is list
      && data.completedLessonIds.size() <= 200
      && (data.completedLessonIds.size() == 0 || data.completedLessonIds[0] is string)
      && data.quizAnswers is map
      && data.quizAnswers.size() <= 200
      && (!('examResults' in data) || (data.examResults is map && data.examResults.size() <= 200))
      && data.notesByLesson is map
      && data.notesByLesson.size() <= 200
      && data.supervisorNotes is string
      && data.supervisorNotes.size() <= 1000
      && data.attendanceRate is int
      && data.attendanceRate >= 0
      && data.attendanceRate <= 100
      && (!('attendanceDates' in data) || (data.attendanceDates is map && data.attendanceDates.size() <= 200))
      && (!('walletBalance' in data) || (data.walletBalance is int && data.walletBalance >= 0 && data.walletBalance <= 1000000))
      && (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected'])
      && (!('isBlocked' in data) || data.isBlocked is bool)
      && (!('autoBlockExempt' in data) || data.autoBlockExempt is bool)
      && (!('blockReason' in data) || (data.blockReason is string && data.blockReason.size() <= 300))
      && (!('activeDeviceIds' in data) || (data.activeDeviceIds is list && data.activeDeviceIds.size() <= 20 && (data.activeDeviceIds.size() == 0 || data.activeDeviceIds[0] is string)))
      && (!('deviceDetails' in data) || (data.deviceDetails is map && data.deviceDetails.size() <= 20))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPrivateContact(data, studentUid) {
      return data.keys().hasAll([
        'uid',
        'studentPhone',
        'parentName',
        'parentPhone',
        'motherName',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'studentPhone',
        'parentName',
        'parentPhone',
        'parentJob',
        'motherName',
        'email',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == studentUid
      && data.studentPhone is string
      && data.studentPhone.size() >= 8
      && data.studentPhone.size() <= 20
      && data.studentPhone.matches('^[0-9+]+$')
      && data.parentName is string
      && data.parentName.size() >= 2
      && data.parentName.size() <= 120
      && data.parentPhone is string
      && data.parentPhone.size() >= 8
      && data.parentPhone.size() <= 20
      && data.parentPhone.matches('^[0-9+]+$')
      && (!('parentJob' in data) || (data.parentJob is string && data.parentJob.size() <= 120))
      && data.motherName is string
      && data.motherName.size() >= 2
      && data.motherName.size() <= 120
      && (!('email' in data) || (data.email is string && data.email.size() <= 160))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidStudentNotification(data, studentUid, notifId) {
      return data.keys().hasAll([
        'id',
        'studentUid',
        'title',
        'message',
        'read',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'studentUid',
        'title',
        'message',
        'read',
        'createdAt'
      ])
      && isValidId(data.id)
      && data.id == notifId
      && isValidId(data.studentUid)
      && data.studentUid == studentUid
      && data.title is string
      && data.title.size() >= 2
      && data.title.size() <= 120
      && data.message is string
      && data.message.size() >= 2
      && data.message.size() <= 500
      && data.read is bool
      && data.createdAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /students/{studentUid} {
      allow get: if isValidId(studentUid) && (isOwner(studentUid) || isAdmin());
      allow list: if isAdminEmail() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(studentUid)
        && isOwner(studentUid)
        && isValidStudent(incoming(), studentUid)
        && incoming().uid == request.auth.uid
        && (incoming().supervisorNotes == 'طلب تسجيل جديد — في انتظار موافقة المشرف.' || incoming().supervisorNotes == 'حساب جديد — في انتظار المراجعة الأولى.')
        && incoming().attendanceRate == 0
        && (!('walletBalance' in incoming()) || incoming().walletBalance == 0)
        && (!('approvalStatus' in incoming()) || incoming().approvalStatus == 'pending')
        && (!('isBlocked' in incoming()) || incoming().isBlocked == false)
        && (!('autoBlockExempt' in incoming()) || incoming().autoBlockExempt == false)
        && (!('blockReason' in incoming()) || incoming().blockReason == '')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(studentUid)
        && isValidStudent(incoming(), studentUid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(studentUid)
            && (!('approvalStatus' in existing()) || existing().approvalStatus == 'approved')
            && (!('isBlocked' in existing()) || existing().isBlocked == false)
            && (!('walletBalance' in incoming()) || (!('walletBalance' in existing()) && incoming().walletBalance == 0) || ('walletBalance' in existing() && incoming().walletBalance <= existing().walletBalance))
            && (!('isBlocked' in incoming()) || incoming().isBlocked == false || (incoming().isBlocked == true && (!('autoBlockExempt' in existing()) || existing().autoBlockExempt == false)))
            && (!('blockReason' in incoming()) || incoming().isBlocked == true || incoming().blockReason == '')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'unlockedCourseIds',
              'completedLessonIds',
              'quizAnswers',
              'examResults',
              'notesByLesson',
              'attendanceRate',
              'attendanceDates',
              'walletBalance',
              'isBlocked',
              'blockReason',
              'activeDeviceIds',
              'deviceDetails',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(studentUid) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(studentUid) && docId == 'contact' && (isOwner(studentUid) || isAdmin());
        allow list: if false;
        allow create: if isValidId(studentUid)
          && docId == 'contact'
          && isOwner(studentUid)
          && isValidPrivateContact(incoming(), studentUid)
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/students/$(studentUid))
          && get(/databases/$(database)/documents/students/$(studentUid)).data.uid == studentUid;
        allow update: if isValidId(studentUid)
          && docId == 'contact'
          && (isOwner(studentUid) || isAdmin())
          && isValidPrivateContact(incoming(), studentUid)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'studentPhone',
            'parentName',
            'parentPhone',
            'parentJob',
            'motherName',
            'email',
            'updatedAt'
          ])
          && get(/databases/$(database)/documents/students/$(studentUid)).data.uid == studentUid;
        allow delete: if isValidId(studentUid) && docId == 'contact' && isAdmin();
      }

      match /notifications/{notifId} {
        allow get: if isValidId(studentUid) && isValidId(notifId) && (isOwner(studentUid) || isAdmin());
        allow list: if isAdminEmail() || (isVerified() && resource.data.studentUid == request.auth.uid);
        allow create: if isValidId(studentUid)
          && isValidId(notifId)
          && isAdmin()
          && isValidStudentNotification(incoming(), studentUid, notifId)
          && incoming().read == false
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/students/$(studentUid));
        allow update: if isValidId(studentUid)
          && isValidId(notifId)
          && isValidStudentNotification(incoming(), studentUid, notifId)
          && incoming().id == existing().id
          && incoming().studentUid == existing().studentUid
          && incoming().title == existing().title
          && incoming().message == existing().message
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin()
            || (
              isOwner(studentUid)
              && (!('isBlocked' in get(/databases/$(database)/documents/students/$(studentUid)).data) || get(/databases/$(database)/documents/students/$(studentUid)).data.isBlocked == false)
              && incoming().read == true
              && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
            )
          );
        allow delete: if isValidId(studentUid) && isValidId(notifId) && isAdmin();
      }
    }
  }
}
